# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/microtask_platform

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads/proofs
MAX_FILE_SIZE_MB=5

# ─── Webhook ──────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_hmac_secret

# ─── External Reseller API (VBoost / fallback tasks) ──────
RESELLER_API_URL=https://api.vboost.ru/v1
RESELLER_API_KEY=your_reseller_api_key
RESELLER_ENABLED=true

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Platform Economics ───────────────────────────────────
PLATFORM_FEE_PERCENT=15
MIN_WITHDRAWAL_AMOUNT=1.00
MIN_CAMPAIGN_BUDGET=1.00
MIN_PAYOUT_PER_TASK=0.01

# ─── Frontend URL (CORS) ──────────────────────────────────
FRONTEND_URL=http://localhost:3000
